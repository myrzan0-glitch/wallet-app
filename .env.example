# Public URL of the site (used in metadata, pass back fields and Google JWT origins)
NEXT_PUBLIC_SITE_URL=https://wallet.myrzan.com

# --- Apple Wallet ---------------------------------------------------------
# From developer.apple.com → Certificates, IDs & Profiles → Pass Type IDs.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.myrzan.wallet
# Shown as the pass issuer in Wallet's pass details (optional).
APPLE_ORGANIZATION_NAME=Myrzan Wallet
# PEM contents, either verbatim (\n escapes are fine) or base64-encoded.
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -out signer.pem -legacy
#   openssl pkcs12 -in pass.p12 -nocerts -out signer.key -legacy
APPLE_SIGNER_CERT_PEM=
APPLE_SIGNER_KEY_PEM=
APPLE_SIGNER_KEY_PASSPHRASE=
# Apple WWDR G4 intermediate: https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
#   openssl x509 -inform der -in AppleWWDRCAG4.cer -out wwdr.pem
APPLE_WWDR_PEM=

# --- Google Wallet --------------------------------------------------------
# Issuer ID from https://pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=
# Service-account key JSON (verbatim or base64). The account must be added
# as a user of the issuer in the Pay & Wallet Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: change to start a new generic class.
GOOGLE_WALLET_CLASS_SUFFIX=generic_v1

# --- Logo hosting for Google Wallet (optional) ----------------------------
# Google needs a public logo URL. Without this, Google passes have no logo.
BLOB_READ_WRITE_TOKEN=
